# ===============================================
# CONFIGURACIÓN - Clínica Dermatológica DermaVida
# Copie este archivo como ".env" y ajuste los valores
# ===============================================
PORT=3000

# Conexión local a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=clinica_dermatologica

# En la nube (Render, Neon, Supabase, Railway) use solo esta variable:
# DATABASE_URL=postgresql://usuario:clave@host:5432/clinica_dermatologica
# DB_SSL=true   (opcional: si no se pone, se detecta solo)

# Clave secreta para firmar los tokens JWT (cámbiela por una larga y aleatoria)
JWT_SECRET=cambie_esta_clave_por_una_muy_segura_2026
JWT_EXPIRES=8h
